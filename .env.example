# Variables de entorno para el despliegue real en producción (Cloudflare + Pey).
# Copia a .env (ignorado por Git) o cárgalas en Cloudflare Secrets / GitHub Actions environment `production`.

# --- Pey (https://portal.pey.mx) ---
# API key live para registrar CLABEs (POST /bank-account) y operar cobros en producción.
PEY_API_KEY=
# Endpoint productivo de Pey.
PEY_API_URL=https://api.pey.mx
# Secreto standardwebhooks de Pey para verificar notificaciones de pagos reales.
PEY_WEBHOOK_SECRET=

# --- Aplicación desplegada (Cloudflare Workers + Containers) ---
# URL pública HTTPS del Worker desplegado (requerida para successUrl / backUrl en Payment Links).
APP_URL=https://contractors-platform.<tu-subdominio>.workers.dev

# --- Despliegue a Cloudflare (GitHub Actions / Wrangler) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Autenticación ---
# Modo general: strict (default en binario) | demo (dev, Docker y Cloudflare)
AUTH_MODE=demo
# Overrides opcionales (true/false) por flag:
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# AUTH_LOCKOUT=true
# AUTH_PIN_RESET_REQUIRES_CODE=true
# AUTH_DEMO_ACCOUNT=false
# AUTH_EXPOSE_CODES=false

# --- Correo SMTP (opcional; sin SMTP_HOST usa LogMailer en logs del servidor) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# MAIL_FROM=Praxis <no-reply@tudominio.mx>
